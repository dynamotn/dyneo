  [ [[.*\.cloud\.microsoft.*]] ] = {
    priority = 9,
    takeover = 'never',
  },
  [ [[.*teams\.live\.com.*]] ] = {
    priority = 9,
    takeover = 'never',
  },
  [ [[.*github\.com\/.*\/blob\/.*]] ] = {
    priority = 9,
    takeover = 'never',
  },
}
{{- if has "F1" .decryptEnterprise }}
require('per_machine.F1')
{{- end }}
{{- if eq .code "l30n4rd0d4v1nc1" }}
DyNeo.used_full_plugins = true
{{- end }}
{{- if .blockedGitlab }}
DyNeo.obsidian.vaults = function() return {} end
{{- end }}
