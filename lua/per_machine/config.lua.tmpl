DyNeo.dark_mode = {{ .darkMode }}
DyNeo.enabled_plugins.obsidian = {{ or (eq .kind "pc" "laptop") (eq .chezmoi.os "android") }}
DyNeo.enabled_plugins.leetcode = {{ eq .kind "pc" "laptop" }}
DyNeo.enabled_plugins.firenvim = {{ eq .kind "pc" "laptop" }}
DyNeo.enabled_plugins.otter = {{ eq .kind "pc" "laptop" }}
DyNeo.enabled_plugins.chezmoi = true
{{- if eq .kind "container" }}
DyNeo.enabled_languages = { 'gitcommit', 'gitrebase', 'bash', 'sql' }
DyNeo.bundle_languages = { 'gitcommit', 'bash', 'sql' }
{{- end }}
{{- if eq .chezmoi.os "android" }}
DyNeo.obsidian.paths.personal = '~/storage/shared/Documents/DyBrain'
{{- end }}
DyNeo.firenvim_site_settings = {
  [ [[.*google\.com.*]] ] = {
    priority = 9,
    takeover = 'never',
  },
  [ [[.*facebook\.com.*]] ] = {
    priority = 9,
    takeover = 'never',
  },
  [ [[.*notion\.so.*]] ] = {
    priority = 9,
    takeover = 'never',
  },
  [ [[.*docs\.google\.com.*]] ] = {
    priority = 9,
    takeover = 'never',
  },
  [ [[.*mail\.google\.com.*]] ] = {
    priority = 9,
    takeover = 'never',
  },
  [ [[.*web\.telegram\.org.*]] ] = {
    priority = 9,
    takeover = 'never',
  },
  [ [[.*jira\..*]] ] = {
    priority = 9,
    takeover = 'never',
  },
  [ [[.*chat\..*]] ] = {
    priority = 9,
    takeover = 'never',
  },
  [ [[.*cloudflare\..*]] ] = {
    priority = 9,
    takeover = 'never',
  },
  -- Microsoft 365: its editors fight firenvim for the text box
  -- SharePoint, OneDrive for work, Stream
  [ [[.*\.sharepoint\.com.*]] ] = {
    priority = 9,
    takeover = 'never',
  },
  -- Office on the web, Forms, Planner, To Do, Whiteboard
  [ [[.*\.office\.com.*]] ] = {
    priority = 9,
    takeover = 'never',
  },
  -- Outlook on `outlook.office365.com`
  [ [[.*\.office365\.com.*]] ] = {
    priority = 9,
    takeover = 'never',
  },
  -- The Microsoft 365 app
  [ [[.*\.microsoft365\.com.*]] ] = {
    priority = 9,
    takeover = 'never',
  },
  -- Teams, Outlook, Microsoft 365, Loop and Engage, moved under
  -- `cloud.microsoft`
  [ [[.*\.cloud\.microsoft.*]] ] = {
    priority = 9,
    takeover = 'never',
  },
  [ [[.*(teams|loop|whiteboard|copilot)\.microsoft\.com.*]] ] = {
    priority = 9,
    takeover = 'never',
  },
  -- Personal Teams, Outlook and OneDrive, and the Word and Excel editors
  -- on `officeapps.live.com`
  [ [[.*\.live\.com.*]] ] = {
    priority = 9,
    takeover = 'never',
  },
  -- Viva Engage
  [ [[.*\.yammer\.com.*]] ] = {
    priority = 9,
    takeover = 'never',
  },
  [ [[.*\.powerbi\.com.*]] ] = {
    priority = 9,
    takeover = 'never',
  },
  [ [[.*github\.com\/.*\/blob\/.*]] ] = {
    priority = 9,
    takeover = 'never',
  },
}
{{- range .decryptEnterprise }}
{{-   if stat (joinPath $.chezmoi.sourceDir "private_dot_config/nvim/lua/per_machine" (printf "encrypted_%s.lua.age" .)) }}
require('per_machine.{{ . }}')
{{-   end }}
{{- end }}
{{- if eq .code "l30n4rd0d4v1nc1" }}
DyNeo.used_full_plugins = true
{{- end }}
