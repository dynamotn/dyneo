# Test dependencies cloned by tests/minimal_init.lua when lazy.nvim has none
/.tests/

# The help tags are generated, but committed all the same, so `:help
# dyneo` works in a fresh clone. The global ignore drops every `tags`.
!/doc/tags

# The global ignore drops every `.claude`. This repository shares its Claude
# Code settings (hooks, plugins) and skills; anything else there is personal.
!/.claude/
/.claude/*
!/.claude/settings.json
!/.claude/skills/
